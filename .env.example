# Node environment
NODE_ENV=production
PORT=3000
BASE_URL=https://your-domain.com

# OpenAI API (for deal negotiation & proposal generation)
OPENAI_API_KEY=sk-...

# PayPal API Credentials
# Get from: https://developer.paypal.com/
PAYPAL_CLIENT_ID=your_client_id
PAYPAL_SECRET=your_secret
PAYPAL_API_BASE=https://api.paypal.com

# Admin credentials
ADMIN_SECRET=your_secure_admin_secret
CREATE_API_KEY_SECRET=your_secure_key_creation_secret

# Database
DB_PATH=./broker.db

# Stripe (optional, for other payment methods)
STRIPE_SECRET_KEY=sk_test_...
STRIPE_WEBHOOK_SECRET=whsec_...
